Table person {
  person_id int [primary key]
  name varchar(100)
  last_name varchar(100)
  birth_date date
  phone varchar(50)
  email varchar(255)
}

Table user {
  user_id int [primary key]
  person_id int
  user_status_id int
  username varchar(30)
  password varchar(20)
}
Table user_status {
  user_status_id int [primary key]
  name varchar(30)
  description varchar(60)
}

Table role {
  role_id int [primary key]
  name varchar(30)
  description varchar(100)
}

Table user_role {
  user_role_id int [primary key]
  user_id int
  role_id int
}

Table category {
  category_id int [primary key]
  name varchar(30)
  description varchar(100)
}

Table product {
  product_id int [primary key]
  category_id int
  name varchar(100)
  description varchar(100)
  sku varchar(100)
  status varchar(50)
}

Table image {
  image_id int [primary key]
  url varchar(255)
}

Table product_image {
  product_image_id int [primary key]
  product_id int
  image_id int
}

Table product_batch {
  product_batch_id int [primary key]
  product_id int
  batch_status_id int
  batch_code varchar(100)
  quantity int
  expiration_date date
}
Table batch_status{
  batch_status_id int [primary key]
  name varchar(30)
  description varchar(60)
}

Table product_price {
  product_price_id int [primary key]
  product_id int
  price decimal
  active boolean
}

Table supplier {
  supplier_id int [primary key]
  name varchar(50)
  description varchar(100)
  phone varchar(20)
  email varchar(50)
}

Table supplier_product {
  supplier_product_id int [primary key]
  supplier_id int
  product_id int
  purchase_price decimal
}

Table inventory {
  inventory_id int [primary key]
  product_id int
  available_stock int
  damaged_stock int
  expired_stock int
  updated_at datetime
}
Table inventory_movement {
  inventory_movement_id int [primary key]
  product_batch_id int
  movement_type_id int
  quantity int
  previous_stock int
  new_stock int
  reason varchar(100)
  created_at datetime
}
Table movement_type {
  movement_type_id int [primary key]
  name varchar(20)
  description varchar(60)
}

Table cart {
  cart_id int [primary key]
  customer_id int
  employee_id int
  status varchar(50)
}

Table cart_product {
  cart_product_id int [primary key]
  cart_id int
  product_batch_id int
  quantity int
  unit_price decimal
  total_price decimal
}

Table payment_method {
  payment_method_id int [primary key]
  name varchar(50)
  description varchar(100)
}

Table sale {
  sale_id int [primary key]
  customer_id int
  employee_id int
  payment_method_id int
  sale_date datetime
  total decimal
  status varchar(50)
}

Table sale_product {
  sale_product_id int [primary key]
  sale_id int
  product_batch_id int
  quantity int
  unit_price decimal
  total_price decimal
}

Ref person_user: person.person_id < user.person_id

Ref user_role_user: user.user_id < user_role.user_id
Ref user_role_role: role.role_id < user_role.role_id

Ref category_product: category.category_id < product.category_id

Ref product_price_product: product.product_id < product_price.product_id

Ref supplier_product_supplier: supplier.supplier_id < supplier_product.supplier_id
Ref supplier_product_product: product.product_id < supplier_product.product_id

Ref inventory_product: product.product_id - inventory.product_id

Ref cart_customer: user.user_id < cart.customer_id
Ref cart_employee: user.user_id < cart.employee_id

Ref cart_product_cart: cart.cart_id < cart_product.cart_id
Ref cart_product_product: product.product_id < cart_product.product_batch_id

Ref sale_customer: user.user_id < sale.customer_id
Ref sale_employee: user.user_id < sale.employee_id

Ref payment_sale: payment_method.payment_method_id < sale.payment_method_id

Ref sale_product_sale: sale.sale_id < sale_product.sale_id
Ref sale_product_product: product.product_id < sale_product.product_batch_id

Ref product_batch_product:
product.product_id < product_batch.product_id

Ref product_batch_status:
batch_status.batch_status_id < product_batch.batch_status_id

Ref inventory_movement_batch:
product_batch.product_batch_id < inventory_movement.product_batch_id

Ref inventory_movement_type:
movement_type.movement_type_id < inventory_movement.movement_type_id

Ref user_status_user:
user_status.user_status_id < user.user_status_id

Ref product_image_product:
product.product_id < product_image.product_id

Ref product_image_product:
image.image_id < product_image.image_id